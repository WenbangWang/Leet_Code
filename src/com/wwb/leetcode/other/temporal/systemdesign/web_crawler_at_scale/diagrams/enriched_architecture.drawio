<mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="seed" value="Seed URLs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="380" y="20" width="200" height="45" as="geometry"/>
    </mxCell>

    <mxCell id="frontier" value="Frontier Queue&#10;msg = URL id only;&#10;visibility-timeout + DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="105" width="300" height="65" as="geometry"/>
    </mxCell>

    <mxCell id="lock" value="Politeness Gate&#10;per-domain lock + sliding-window&#10;rate limiter w/ jitter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="790" y="215" width="260" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="fetcher" value="Fetcher Pool (I/O-bound, high concurrency)&#10;check robots/gate -&gt; resolve DNS -&gt; fetch HTML&#10;-&gt; write URLRecord.httpStatus/blobPtr/status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="300" y="215" width="380" height="80" as="geometry"/>
    </mxCell>

    <mxCell id="dns" value="DNS Resolver + cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="790" y="310" width="260" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="blobhtml" value="Blob Storage&#10;(raw HTML)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="40" y="230" width="220" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="extractionq" value="Extraction Queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="390" y="330" width="200" height="45" as="geometry"/>
    </mxCell>

    <mxCell id="extractor" value="Extraction Pool (CPU-bound, capped near core count)&#10;hash content -&gt; content-seen check -&gt; extract links&#10;-&gt; url-seen check -&gt; depth check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="300" y="410" width="380" height="80" as="geometry"/>
    </mxCell>

    <mxCell id="blobtext" value="Blob Storage&#10;(extracted content)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="40" y="425" width="220" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="dedup" value="Content-Seen? Check&#10;ContentRecord lookup by hash" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="790" y="410" width="260" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="urlseen" value="URL-Seen? Check&#10;URLRecord lookup by url" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="790" y="500" width="260" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="metadb" value="Metadata Store&#10;URLRecord (url, depth, parentUrl, status, httpStatus, contentHash, blob pointers)&#10;DomainRecord (robots rules, lastCrawlTime)&#10;ContentRecord (hash to blob pointer)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="300" y="545" width="380" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="seed" target="frontier"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="frontier" target="fetcher"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" value="check/acquire" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="fetcher" target="lock"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="fetcher" target="dns"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e5" value="raw HTML" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="fetcher" target="blobhtml"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e6" value="msg: URL id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fetcher" target="extractionq"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="extractionq" target="extractor"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e8" value="read HTML" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="extractor" target="blobhtml"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="330"/></Array></mxGeometry></mxCell>
    <mxCell id="e9" value="content-seen?" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="extractor" target="dedup"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e10" value="url-seen? (per link)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="extractor" target="urlseen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="470"/></Array></mxGeometry></mxCell>
    <mxCell id="e11" value="extracted content" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.7;entryX=1;entryY=0.5;" edge="1" parent="1" source="extractor" target="blobtext"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="extractor" target="metadb"><mxGeometry relative="1" as="geometry"/></mxCell>

    <mxCell id="e13" value="new URLRecords&#10;re-enqueued" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="urlseen" target="frontier">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1070" y="518"/>
          <mxPoint x="1070" y="137"/>
        </Array>
      </mxGeometry>
    </mxCell>
  </root>
</mxGraphModel>